<Project xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:gnome="http://api.gnome.org/doap-extensions#"
         xmlns="http://usefulinc.com/ns/doap#">
  <name xml:lang="en">Semitone</name>
  <shortdesc xml:lang="en">Play your music elegantly</shortdesc>
  <description xml:lang="en">A fast, fluent, lightweight music player written in GTK4/libadwaita, with synced lyrics, queue management, sleep timer, and a beautiful adaptive user interface.</description>
  <category rdf:resource="http://api.gnome.org/doap-extensions#apps" />
  <homepage rdf:resource="https://github.com/Lalaggi/Semitone" />
  <bug-database rdf:resource="https://github.com/Lalaggi/Semitone/issues" />
  <programming-language>Vala</programming-language>
  <platform>GTK 4</platform>
  <platform>Libadwaita</platform>
  <maintainer>
    <foaf:Person>
      <foaf:name>Lalaggi</foaf:name>
      <foaf:account>
        <foaf:OnlineAccount>
          <foaf:accountServiceHomepage rdf:resource="https://github.com"/>
          <foaf:accountName>Lalaggi</foaf:accountName>
        </foaf:OnlineAccount>
      </foaf:account>
    </foaf:Person>
  </maintainer>
</Project>
